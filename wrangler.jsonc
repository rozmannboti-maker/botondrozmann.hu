// 2026-11-12: Cloudflare Worker (statikus fájlok) a botondrozmann.hu-hoz. A Cloudflare minden
// GitHub-push után lefuttatja az `npm run build`-et, és a dist mappát teszi ki.
{
  "name": "botondrozmann-hu",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // nem létező címre valódi 404 (ne a főoldal jöjjön 200-zal: a Google ezt „soft 404”-nek veszi)
    "not_found_handling": "none"
  }
}
