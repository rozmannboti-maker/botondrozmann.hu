// 2026-11-12: Cloudflare Worker (statikus fájlok) a botondrozmann.hu-hoz. A Cloudflare minden
// GitHub-push után lefuttatja az `npm run build`-et, és a dist mappát teszi ki.
// 2026-11-27: RB Panel a /panel alatt (SPA-útválasztás a Workerben).
// 2026-11-19: Kapcsolat-űrlap. A Worker-kód (worker/index.ts) CSAK az /api/* kéréseket kapja,
// minden más változatlanul a statikus fájlokból jön.
{
  "name": "botondrozmann-hu",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/panel", "/panel/*", "/admin", "/admin/*"],
    // nem létező címre valódi 404 (ne a főoldal jöjjön 200-zal: a Google ezt „soft 404”-nek veszi)
    "not_found_handling": "none"
  },
  "vars": {
    "ADMIN_EMAIL": "rozmann.boti@gmail.com"
  }
  // secret (nem a repóban): BREVO_API_KEY  →  npx wrangler secret put BREVO_API_KEY
}
